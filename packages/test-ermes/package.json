{
  "name": "test-ermes",
  "version": "1.0.0",
  "description": "Test for ermes implementation",
  "type": "module",
  "keywords": [
    "test"
  ],
  "author": "Luca Gualandi <lgualandi@omniagroup.it>",
  "homepage": "https://github.com/elguala9/InterfaceErmes/tree/main/packages/test-ermes#readme",
  "license": "MIT",
  "main": "dist/index.js",
  "directories": {
    "src": "src"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elguala9/Ermes.git"
  },
  "scripts": {
    "barrelsby": "barrelsby --directory src --delete --barrelName index.ts --extensions ts",
    "build": "tsc -b",
    "test:book": "mocha --require ts-node/register 'src/book/ErmesBook.spec.ts' --timeout 10000",
    "test:book-repo": "mocha --require ts-node/register 'src/signaling-test/ErmesBookRepository.spec.ts' --timeout 10000",
    "test:message-control-persistence": "ts-mocha --project tsconfig.json ./src/standard-test/ErmesMessageControlPersistence.spec.ts --timeout 30000"
  },
  "bugs": {
    "url": "https://github.com/elguala9/Ermes/issues"
  },
  "devDependencies": {
    "@types/chai": "^5.2.1",
    "@types/mocha": "^10.0.10",
    "chai-as-promised": "^8.0.1"
  },
  "dependencies": {
    "@types/sinon": "^17.0.4",
    "chai": "^5.2.0",
    "ermes-types": "1.0.0",
    "iermes": "1.0.0",
    "mocha": "^10.8.2",
    "signaling-sdk": "1.0.0",
    "sinon": "^21.0.0",
    "ts-mocha": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "uuid": "^11.1.0"
  }
}
