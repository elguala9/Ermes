{
  "name": "test-root",
  "version": "0.0.0",
  "description": "handle the tests",

  "keywords": [
    "test"
  ],
  "author": "Luca Gualandi <lgualandi@omniagroup.it>",
  "homepage": "https://github.com/elguala9/InterfaceErmes/tree/main/packages/test-root#readme",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elguala9/Ermes.git"
  },
  "scripts": {
    "clean_db": "powershell -Command \"Get-ChildItem -Directory -Filter 'test-db*' | Remove-Item -Recurse -Force\"",
    "test:caching": "ts-mocha --project tsconfig.json ./src/ErmesCaching.ts",
    "test:storage": "npm run clean_db && ts-mocha --project tsconfig.json ./src/ErmesStorage.ts",
    "test:idhandler": "ts-mocha --project tsconfig.json ./src/ErmesIdHandler.ts",
    "test:ermes": "ts-mocha --project tsconfig.json ./src/ErmesService.ts",
    "test:ermes-signaling-repo": "ts-mocha --project tsconfig.json ./src/ErmesSignalingRepo.ts --timeout 35000",
    "test:ermes-signaling-server": "ts-mocha --project tsconfig.json ./src/ErmesSignalingServer.ts --timeout 35000",
    "test:ermes-serialization": "ts-mocha --project tsconfig.json ./src/ErmesSerialization.ts  --timeout 15000",
    "test:ermes-sc": "npm run test:ermes-sc-standard && npm run test:ermes-sc-callback",
    "test:ermes-sc-standard": "ts-mocha --project tsconfig.json ./src/ErmesSmartContract.ts --timeout 15000",
    "test:ermes-sc-callback": "ts-mocha --project tsconfig.json ./src/ErmesSmartContractCallback.ts --timeout 15000",
    "test:ermes-handler": "ts-mocha --project tsconfig.json ./src/ErmesSignalingHandler.ts --timeout 30000",
    "test:ermes-repository": "ts-mocha --project tsconfig.json ./src/ErmesRepository.ts --timeout 30000",
    "test:ermes-service": "ts-mocha --project tsconfig.json ./src/ErmesService.ts --timeout 30000",
    "test:ermes-sc-multi-offer": "npm run test:ermes-sc-multi-offer-standard && npm run test:ermes-sc-multi-offer-callback",
    "test:ermes-sc-multi-offer-standard": "ts-mocha --project tsconfig.json ./src/ErmesSmartContractMultiOffer.ts --timeout 15000",
    "test:ermes-sc-multi-offer-callback": "ts-mocha --project tsconfig.json ./src/ErmesSmartContractMultiOfferCallback.ts --timeout 15000"
  },
  "bugs": {
    "url": "https://github.com/elguala9/Ermes/issues"
  },
  "devDependencies": {
    "ermes-types": "1.0.0"
  },
  "dependencies": {
    "test-ermes": "1.0.0",
    "ermes-storage": "1.0.0",
    "signaling-sdk": "1.0.0"
  }
}
