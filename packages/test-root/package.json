{
  "name": "test-root",
  "version": "0.0.0",
  "description": "handle the tests",

  "keywords": [
    "test"
  ],
  "author": "Luca Gualandi <lgualandi@omniagroup.it>",
  "homepage": "https://github.com/elguala9/InterfaceErmes/tree/main/packages/test-root#readme",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elguala9/Ermes.git"
  },
  "scripts": {
    "test:caching": "ts-mocha --project tsconfig.json ./src/ErmesCaching.ts",
    "test:storage": "ts-mocha --project tsconfig.json ./src/ErmesStorage.ts",
    "test:idhandler": "ts-mocha --project tsconfig.json ./src/ErmesIdHandler.ts",
    "test:ermes": "ts-mocha --project tsconfig.json ./src/ErmesService.ts",
    "test:ermes-sc": "npm run test:ermes-sc-standard && npm run test:ermes-sc-callback",
    "test:ermes-sc-standard": "ts-mocha --project tsconfig.json ./src/ErmesSmartContract.ts --timeout 15000",
    "test:ermes-sc-callback": "ts-mocha --project tsconfig.json ./src/ErmesSmartContractCallback.ts --timeout 15000"

  },
  "bugs": {
    "url": "https://github.com/elguala9/Ermes/issues"
  },
  "devDependencies": {
    "ermes-types": "1.0.0"
  },
  "dependencies": {
    "test-ermes": "1.0.0",
    "ermes-storage": "1.0.0",
    "signaling-sdk": "1.0.0"
  }
}
