{
  "name": "contract-handler",
  "version": "0.0.0",
  "description": "General contract handler",
  "keywords": [
    "blockchain"
  ],
  "author": "Luca Gualandi <lgualandi@omniagroup.it>",
  "homepage": "https://github.com/elguala9/InterfaceErmes/tree/main/packages/contract-handler#readme",
  "license": "GPL-2.0-only",
  "main": "dist/index.js",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elguala9/Ermes.git"
  },
  "scripts": {
    "barrelsby": "barrelsby --directory src --delete --barrelName index.ts --extensions ts",
    "build": "tsc -b && npm run gen-exports",
    "gen-exports": "npx gen-exports dist -p package.json"
  },
  "bugs": {
    "url": "https://github.com/elguala9/Ermes/issues"
  },
  "exports": {
    "./ContractHandler": {
      "import": "./dist/ContractHandler.js",
      "require": "./dist/ContractHandler.js",
      "types": "./dist/ContractHandler.d.ts"
    },
    "./IContractHandler": {
      "import": "./dist/IContractHandler.js",
      "require": "./dist/IContractHandler.js",
      "types": "./dist/IContractHandler.d.ts"
    },
    "./index": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./Utility": {
      "import": "./dist/Utility.js",
      "require": "./dist/Utility.js",
      "types": "./dist/Utility.d.ts"
    }
  }
}
