{
  "name": "ermes-storage",
  "version": "1.0.0",
  "description": "Implementation of interfaces regarding storing and caching",
  "keywords": [
    "ermes"
  ],
  "type": "module",
  "author": "Luca Gualandi <lgualandi@omniagroup.it>",
  "homepage": "https://github.com/elguala9/InterfaceErmes/tree/main/packages/ermes-storage#readme",
  "license": "LGPL-3.0-or-later",
  "directories": {
    "dist": "dist"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elguala9/Ermes.git"
  },
  "scripts": {
    "barrelsby": "barrelsby --directory src --delete --barrelName index.ts --extensions ts",
    "build": "tsc -b",
    "gen-exports": "npx gen-exports dist -p package.json",
    "gen:schemas-old": "typescript-json-schema tsconfig.json MessageTypeStorage --topRef --noExtraProps --required --out ./src/storage-implementation/schemas.json",
    "gen:schema:MessageDataStorage": "ts-json-schema-generator --path \"src/**/*.ts\" --tsconfig tsconfig.json --type MessageDataStorage --expose none --out src/storage-implementation/schemas/MessageDataStorage.json",
    "gen:schema:ServiceMessageStorage": "ts-json-schema-generator --path \"src/**/*.ts\" --tsconfig tsconfig.json --type ServiceMessageStorage --expose none --out src/storage-implementation/schemas/ServiceMessageStorage.json",
    "gen:schema:MessageChunkStorage": "ts-json-schema-generator --path \"src/**/*.ts\" --tsconfig tsconfig.json --type MessageChunkStorage --expose none --out src/storage-implementation/schemas/MessageChunkStorage.json",
    "gen:schema:all": "npm run gen:schema:MessageDataStorage && npm run gen:schema:ServiceMessageStorage && npm run gen:schema:MessageChunkStorage"
  },
  "bugs": {
    "url": "https://github.com/elguala9/Ermes/issues"
  },
  "exports": {
    "./ErmesStorageAndCaching": {
      "import": "./dist/ErmesStorageAndCaching.js",
      "require": "./dist/ErmesStorageAndCaching.js",
      "types": "./dist/ErmesStorageAndCaching.d.ts"
    },
    "./ErmesStorageType": {
      "import": "./dist/ErmesStorageType.js",
      "require": "./dist/ErmesStorageType.js",
      "types": "./dist/ErmesStorageType.d.ts"
    },
    "./index": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./NormalizeData": {
      "import": "./dist/NormalizeData.js",
      "require": "./dist/NormalizeData.js",
      "types": "./dist/NormalizeData.d.ts"
    },
    "./UtilityStorage": {
      "import": "./dist/UtilityStorage.js",
      "require": "./dist/UtilityStorage.js",
      "types": "./dist/UtilityStorage.d.ts"
    },
    "./caching-implementation/ErmesCachingRepository": {
      "import": "./dist/caching-implementation/ErmesCachingRepository.js",
      "require": "./dist/caching-implementation/ErmesCachingRepository.js",
      "types": "./dist/caching-implementation/ErmesCachingRepository.d.ts"
    },
    "./caching-implementation/ErmesCachingService": {
      "import": "./dist/caching-implementation/ErmesCachingService.js",
      "require": "./dist/caching-implementation/ErmesCachingService.js",
      "types": "./dist/caching-implementation/ErmesCachingService.d.ts"
    },
    "./factories/ErmesCachingFacories": {
      "import": "./dist/factories/ErmesCachingFacories.js",
      "require": "./dist/factories/ErmesCachingFacories.js",
      "types": "./dist/factories/ErmesCachingFacories.d.ts"
    },
    "./factories/ErmesCachingStorageFacories": {
      "import": "./dist/factories/ErmesCachingStorageFacories.js",
      "require": "./dist/factories/ErmesCachingStorageFacories.js",
      "types": "./dist/factories/ErmesCachingStorageFacories.d.ts"
    },
    "./factories/ErmesStorageFacories": {
      "import": "./dist/factories/ErmesStorageFacories.js",
      "require": "./dist/factories/ErmesStorageFacories.js",
      "types": "./dist/factories/ErmesStorageFacories.d.ts"
    },
    "./storage-implementation/ErmesStorageRepository": {
      "import": "./dist/storage-implementation/ErmesStorageRepository.js",
      "require": "./dist/storage-implementation/ErmesStorageRepository.js",
      "types": "./dist/storage-implementation/ErmesStorageRepository.d.ts"
    },
    "./storage-implementation/ErmesStorageService": {
      "import": "./dist/storage-implementation/ErmesStorageService.js",
      "require": "./dist/storage-implementation/ErmesStorageService.js",
      "types": "./dist/storage-implementation/ErmesStorageService.d.ts"
    },
    "./storage-implementation/Factories.ts": {
      "import": "./dist/storage-implementation/Factories.ts.js",
      "require": "./dist/storage-implementation/Factories.ts.js",
      "types": "./dist/storage-implementation/Factories.ts.d.ts"
    },
    "./storage-implementation/SchemaDefinition": {
      "import": "./dist/storage-implementation/SchemaDefinition.js",
      "require": "./dist/storage-implementation/SchemaDefinition.js",
      "types": "./dist/storage-implementation/SchemaDefinition.d.ts"
    }
  },
  "dependencies": {
    "ermes-types": "1.0.0",
    "workdb": "^1.0.1"
  },
  "devDependencies": {}
}
