{
  "name": "iermes",
  "version": "1.0.0",
  "description": "Interfaces for the package ermes",
  "license": "GPL-2.0-only",
  "author": "Luca Gualandi",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "barrelsby": "barrelsby --directory src --delete --barrelName index.ts --extensions ts",
    "build": "tsc -b",
    "gen-exports": "npx gen-exports dist -p package.json"
  },
  "exports": {
