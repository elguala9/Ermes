{
  "name": "monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "GPL-2.0-only",
  "homepage": "https://github.com/elguala9/InterfaceErmes#readme",
  "bugs": {
    "url": "https://github.com/elguala9/InterfaceErmes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elguala9/InterfaceErmes.git"
  },
  "scripts": {
    "build": "npx lage build",
    "barrelsby": "npx lage barrelsby && npm run add-js",
    "gen-exports": "npx lage gen-exports",
    "test": "npx lage test",
    "clean": "rimraf packages/*/dist",
    "add-js": "ts-node utility/add-js-import.ts",
    "prepare-for-test": "npm run barrelsby && npm run build && npm run gen-exports",
    "test:caching": "ts-mocha --project tsconfig.json packages/test-root/src/ErmesCaching.ts",
    "test:storage": "ts-mocha --project tsconfig.json packages/test-root/src/ErmesStorage.ts",
    "test:idhandler": "ts-mocha --project tsconfig.json packages/test-root/src/ErmesIdHandler.ts",
    "test:ermes": "ts-mocha --project tsconfig.json packages/test-root/src/ErmesService.ts",
    "test:ermes-connection": "ts-mocha --project tsconfig.json packages/test-root/src/ErmesServiceConnection.ts",
    "postbuild": "npm install"
  },
  "devDependencies": {
    "@types/gun": "^0.9.6",
    "@types/node": "^22.15.3",
    "barrelsby": "^2.8.1",
    "copyfiles": "^2.4.1",
    "fast-glob": "^3.3.3",
    "lage": "^2.14.6",
    "lerna": "^8.2.2",
    "mocha": "^11.2.2",
    "ts-json-schema-generator": "^2.4.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript-json-schema": "^0.65.1"
  },
  "dependencies": {
    "ermes": "1.0.0",
    "ermes-storage": "1.0.0",
    "ermes-types": "^1.0.0",
    "gen-exports": "^1.1.2",
    "iermes": "1.0.0",
    "observable-list": "^1.0.0"
  }
}

