{
  "name": "monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "GPL-2.0-only",
  "homepage": "https://github.com/elguala9/InterfaceErmes#readme",
  "bugs": {
    "url": "https://github.com/elguala9/InterfaceErmes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elguala9/InterfaceErmes.git"
  },
  "scripts": {
    "build": "npx lage build",
    "barrelsby": "npx lage barrelsby && npm run add-js",
    "gen-exports": "npx lage gen-exports",
    "deploySC": "npx lage deploySC --no-cache",
    "test": "npx lage test",
    "clean": "rimraf packages/*/dist",
    "add-js": "ts-node utility/add-js-import.ts -ed typeschain",
    "compile": "npm run barrelsby && npm run build && npm run gen-exports",
    "prepareTest": "npm run compile",
    "test:caching": "cd ./packages/test-root && npm run test:caching",
    "test:storage": "cd ./packages/test-root && npm run test:storage",
    "test:idhandler": "cd ./packages/test-root && npm run test:idhandler",
    "test:ermes": "cd ./packages/test-root && npm run test:ermes",
    "test:ermes-sc": "npm run deploySC && cd ./packages/test-root && npm run test:ermes-sc",
    "test:all": "npm run test:caching && npm run test:idhandler && npm run test:idhandler && npm run test:ermes && npm run test:ermes-sc",
    "network": "cd packages/signaling-contract && npm run network",
    "postbuild": "npm install"
  },
  "devDependencies": {
    "@types/gun": "^0.9.6",
    "@types/node": "^22.15.3",
    "barrelsby": "^2.8.1",
    "copyfiles": "^2.4.1",
    "fast-glob": "^3.3.3",
    "lage": "^2.14.6",
    "lerna": "^8.2.2",
    "mocha": "^11.2.2",
    "ts-json-schema-generator": "^2.4.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript-json-schema": "^0.65.1"
  },
  "dependencies": {
    "ermes": "1.0.0",
    "ermes-storage": "1.0.0",
    "ermes-types": "^1.0.0",
    "gen-exports": "^1.1.2",
    "iermes": "1.0.0",
    "observable-list": "^1.0.0"
  }
}

